# =============================================================================
# Asva Innovation Lab — environment configuration
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit a real .env. In staging/production set these in your hosting
# provider's secret manager instead of a file.
#
# Generate a strong secret (64 random bytes, base64url):
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
# =============================================================================

# ----------------------------------------------------------------------------- shared
# development | test | production
NODE_ENV=development

# ----------------------------------------------------------------------------- API (apps/api)
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the API (for correct client IPs / rate limits)
TRUST_PROXY=1

# Public URL of the website. Used for CORS, email links and Origin (CSRF) checks.
FRONTEND_URL=http://localhost:3000
# Public URL of the API (informational, used in docs)
API_PUBLIC_URL=http://localhost:4000
# Extra allowed browser origins, comma separated (optional)
CORS_ORIGINS=

# PostgreSQL connection string. Use sslmode=require for managed databases in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asva?schema=public

# Signs short-lived access tokens (JWT, HS256). >= 32 chars, unique per environment.
JWT_ACCESS_SECRET=change-me-generate-a-64-byte-random-secret-for-access-tokens
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Keys HMACs for IP fingerprints and newsletter links. >= 32 chars, different from JWT secret.
TOKEN_HASH_SECRET=change-me-generate-a-different-64-byte-random-secret-for-hmacs
# Cookies are Secure by default when NODE_ENV=production. Set false only for plain-http local dev.
COOKIE_SECURE=false
# Optional cookie domain, e.g. .asvainnovationlab.com when web and API share a parent domain
COOKIE_DOMAIN=

# ----------------------------------------------------------------------------- email (SMTP)
# Leave SMTP_HOST empty to disable delivery: emails are recorded as SKIPPED and a warning is logged.
# Local testing: `docker compose up mailpit` then use SMTP_HOST=localhost SMTP_PORT=1025 (UI: http://localhost:8025)
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# e.g. "Asva Innovation Lab <no-reply@your-domain.com>"
EMAIL_FROM=
EMAIL_REPLY_TO=

# ----------------------------------------------------------------------------- media storage
# local = files on disk (development or a server with a persistent volume)
# s3    = any S3-compatible object storage (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage
STORAGE_BUCKET=
# AWS region, or "auto" for Cloudflare R2
STORAGE_REGION=auto
# Custom endpoint for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
# Optional CDN/public base URL that serves ONLY the `public/` prefix of the bucket.
# If empty, public files are streamed through the API.
STORAGE_PUBLIC_URL=

MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_DOCUMENT_MB=10
RESUME_MAX_MB=5

# ----------------------------------------------------------------------------- spam protection
# Optional Cloudflare Turnstile. When the secret is set, public forms require a token.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Minimum seconds between rendering and submitting a public form
FORM_MIN_FILL_SECONDS=3

# ----------------------------------------------------------------------------- background jobs & docs
# Scheduled publishing, email outbox, retention. Keep true on at least one API instance.
SCHEDULER_ENABLED=true
# Swagger UI at /api/docs. Defaults to false in production.
SWAGGER_ENABLED=true

# ----------------------------------------------------------------------------- data retention (days)
RETENTION_CONTACT_DAYS=730
RETENTION_INQUIRY_DAYS=1095
RETENTION_APPLICATION_DAYS=365
RETENTION_AUDIT_DAYS=730
RETENTION_EMAIL_DAYS=90

# ----------------------------------------------------------------------------- cache revalidation (API -> web)
# The API calls this endpoint after CMS changes so the public site updates immediately.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Shared secret between API and web. Generate a random value.
REVALIDATE_SECRET=change-me-generate-a-random-revalidation-secret

# ----------------------------------------------------------------------------- web (apps/web)
# Canonical public site URL (used for metadata, sitemap, canonical links). Safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side URL the web app uses to reach the API (internal network address in production).
# Browser requests go to /api/v1/* on the web origin and are proxied here.
API_INTERNAL_URL=http://localhost:4000
# Seconds before cached public pages are refreshed even without a revalidation call.
REVALIDATE_SECONDS=300

# Analytics IDs are configured in Admin → Settings → Analytics (loaded only after consent).
# Never put secrets in NEXT_PUBLIC_* variables — they are sent to the browser.
