{
  "$schema": "../../apps/web/node_modules/wrangler/config-schema.json",
  "name": "asva-api-keepalive",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "triggers": {
    // Pings the Render API every 5 minutes so it never sits idle long enough
    // to spin down (free-tier Render web services sleep after 15 min idle).
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "HEALTH_CHECK_URL": "https://asva-api-67cq.onrender.com/api/v1/health/live"
  },
  "observability": {
    "enabled": true
  }
}
